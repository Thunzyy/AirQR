# AirQR local launcher internal ports
AIRQR_WEB_PORT=5173
AIRQR_SYNC_PORT=8081
# Optional split-port dev override only. Leave commented for the default unified listener.
# AIRQR_WS_PORT=8082

# Optional TLS files for -https mode
# AIRQR_TLS_CERT=services/sync-server/cert.pem
# AIRQR_TLS_KEY=services/sync-server/key.pem

# Required for the first public start with a fresh Compose volume. Existing
# deployments whose mounted users.json has a valid user/API key may leave both
# blank. Replace both values together; never deploy sample credentials.
AIRQR_BOOTSTRAP_USERNAME=
AIRQR_BOOTSTRAP_PASSWORD=

# Docker Compose settings
# AIRQR_PORT=8081
# TZ=UTC
