TZ=Europe/Paris

# Persistent storage paths
AIRQR_STORAGE_DIR=./storage
AIRQR_USERS_FILE=./users.json

# Required on the first public (non-loopback) start with an empty users database.
# Existing deployments with a valid user/API key may leave both blank. Replace
# both values together; the bootstrap does not overwrite an existing user.
AIRQR_BOOTSTRAP_USERNAME=
AIRQR_BOOTSTRAP_PASSWORD=
