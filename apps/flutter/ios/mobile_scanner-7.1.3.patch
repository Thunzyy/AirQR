+
+    private func recordAnalysisFrame() {
+        analysisRateLock.lock()
+        analysisFrames += 1
+        analysisRateLock.unlock()
+    }
+
+    private func readAnalysisFps() -> Double {
+        let now = ProcessInfo.processInfo.systemUptime
+        analysisRateLock.lock()
+        defer { analysisRateLock.unlock() }
+        let elapsed = max(now - analysisWindowStart, 0.001)
+        let fps = Double(analysisFrames) / elapsed
+        analysisFrames = 0
+        analysisWindowStart = now
+        return fps
+    }
     
