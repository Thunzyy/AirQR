+
+    private func configureHighFrameRate(_ camera: AVCaptureDevice) {
+        let referencePixels = Int64(1920 * 1080)
+        let formats = camera.formats.flatMap { format in
+            let dimensions = CMVideoFormatDescriptionGetDimensions(format.formatDescription)
+            let pixels = Int64(dimensions.width) * Int64(dimensions.height)
+            return format.videoSupportedFrameRateRanges.map { range in
+                (format: format, range: range, distance: abs(referencePixels - pixels))
+            }
+        }
+        guard let fastest = formats.max(by: { lhs, rhs in
+            if lhs.range.maxFrameRate != rhs.range.maxFrameRate {
+                return lhs.range.maxFrameRate < rhs.range.maxFrameRate
+            }
+            return lhs.distance > rhs.distance
+        }), fastest.range.maxFrameRate > 30 else {
+            return
+        }
+
+        do {
+            try camera.lockForConfiguration()
+            defer { camera.unlockForConfiguration() }
+            // Choosing the active format selects input-priority mode on iOS.
+            camera.activeFormat = fastest.format
+            camera.activeVideoMinFrameDuration = fastest.range.minFrameDuration
+            camera.activeVideoMaxFrameDuration = fastest.range.minFrameDuration
+            NSLog("AirQR camera requested %.2f FPS", fastest.range.maxFrameRate)
+        } catch {
+            NSLog("AirQR camera kept its default format: %@", error.localizedDescription)
+        }
+    }
+#endif
