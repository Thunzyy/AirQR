# AirQR Web Environment Variables

# Logging level: debug | info | warn | error
# Default: info
VITE_LOG_LEVEL=info

# Optional sync endpoints for local Vite dev proxying.
# Production should not need any of these: the browser should stay on one
# HTTPS origin and use same-origin `/api/...` plus `/api/v1/ws/...`.
# Defaults:
# - VITE_SYNC_SERVER_URL=http://127.0.0.1:8081
# - VITE_SYNC_EVENTS_WS_TARGET=<derived from VITE_SYNC_SERVER_URL on the same origin/port>
# Set a WS override only when your local/dev sync-server keeps a separate internal
# WebSocket listener.
# VITE_SYNC_SERVER_URL=http://127.0.0.1:8081
# VITE_SYNC_EVENTS_WS_TARGET=ws://127.0.0.1:8082

# Optional local-dev client bootstrap.
# These values are embedded in the Vite dev bundle when set; use only for
# trusted local testing and never for production builds.
# VITE_AIRQR_DEV_SYNC_URL=https://airqr.example.com
# VITE_AIRQR_DEV_SYNC_USERNAME=admin
# VITE_AIRQR_DEV_SYNC_PASSWORD=change-me

# Optional HTTPS cert override for local Vite dev server.
# Leave commented unless you use your own certificate files.
# VITE_SSL_CERT=./certs/localhost.pem
# VITE_SSL_KEY=./certs/localhost-key.pem
